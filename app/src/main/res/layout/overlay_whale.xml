<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗内容：拖动把手 + 气泡 + 鲸鱼图。
  气泡用 wrap_content 定位在鲸鱼上方，所以左右吸边时都不会被裁掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="52dp">

    <!-- 拖动把手（可把窗口拖到屏幕任意位置） -->
    <FrameLayout
        android:id="@+id/handle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:background="@drawable/handle_bg"
        android:contentDescription="@string/app_name">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✥"
            android:textColor="#203170"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 余额气泡（失败时显示错误文字，长按可复制） -->
    <TextView
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bubble_bg"
        android:maxWidth="260dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:singleLine="false"
        android:text="…"
        android:textColor="#536BA9"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 鲸鱼本体（作者 DSniang1.png 的 cut-out） -->
    <ImageView
        android:id="@+id/whale"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|center_horizontal"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/whale" />
</FrameLayout>
